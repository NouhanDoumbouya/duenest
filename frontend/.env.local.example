# Copy this file to .env.local and adjust as needed. Do NOT commit .env.local.

# Same-origin API path. The frontend proxies /api/v1/* to the backend (see
# next.config.ts), which keeps the HttpOnly auth cookies first-party — this is
# what makes cookie auth + route protection work via localhost, 127.0.0.1, OR a
# LAN IP. Leave this as the relative path for local development.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Where the Next dev server forwards /api/v1/* (server-side only). Point this at
# your running Django backend.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Cookie names (must match the backend AUTH_*_COOKIE_NAME settings). Defaults
# shown; only set these if you customize them on the backend.
# NEXT_PUBLIC_CSRF_COOKIE_NAME=duenest_csrftoken
# NEXT_PUBLIC_ACCESS_COOKIE_NAME=duenest_access
# NEXT_PUBLIC_REFRESH_COOKIE_NAME=duenest_refresh

# Split-origin setups only (NOT recommended for dev): set an absolute URL and
# configure backend CORS/CSRF + SameSite=None;Secure cookies yourself.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Landing-page messaging. Defaults to private-beta (waitlist CTA). Set to "false"
# at build time when you open public signup, to flip the hero/CTAs to the
# "Start your 14-day free trial" flow. Build-time so the landing page stays
# static (no backend call to render).
# NEXT_PUBLIC_PRIVATE_BETA_ENABLED=true

# AI marketing (landing AI section + FAQ + the Pro AI-assist highlight). Default
# off, INDEPENDENT of the beta flag. Set to "true" at build time only once the AI
# features are actually available to users (AI flags enabled + ANTHROPIC_API_KEY
# set), so you never advertise AI that users can't use yet.
# NEXT_PUBLIC_AI_ENABLED=false
