# Copy this file to .env and fill in real values. Do NOT commit .env.
#
# ===========================================================================
# RAILWAY STAGING QUICK-START (see docs/deployment/railway-backend-staging.md)
#
# The MINIMUM Railway service variables to boot the backend on private staging.
# These are the ACTUAL names the code reads (note the DJANGO_ prefixes). Set
# them in the Railway service → Variables tab (NOT in this committed file).
#
#   DJANGO_SETTINGS_MODULE=config.settings.production
#   DJANGO_SECRET_KEY=<50+ char random>          # python -c "import secrets;print(secrets.token_urlsafe(64))"
#   DJANGO_DEBUG=False
#   DJANGO_SECURE_SSL_REDIRECT=True              # Railway terminates TLS; keep True
#   DJANGO_ALLOWED_HOSTS=.up.railway.app,localhost,127.0.0.1
#   DJANGO_CORS_ALLOWED_ORIGINS=https://app.certanest.com   # exact origin, no trailing slash (use your real host URL)
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://app.certanest.com,https://api.certanest.com
#   DJANGO_COOKIE_SAMESITE=None   # REQUIRED for cross-site (e.g. Vercel↔Railway) browser auth cookies
#   # Production domain reference: docs/CERTANEST_PRODUCTION_DOMAINS.md
#   DATABASE_URL=${{Postgres.DATABASE_URL}}      # Railway reference variable
#   DUENEST_ACTIVE_KEK_VERSION=v1                # REQUIRED — prod boot fails without a KEK
#   DUENEST_KEK_V1_B64=<base64 32 bytes>         # python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
#   APP_ENV=staging
#   # Email: console backend is fine for staging until a real provider is set.
#   EMAIL_PROVIDER=console
#   DEFAULT_FROM_EMAIL=CertaNest <noreply@certanest.local>
#   FOUNDER_ALLOW_ALL_STAFF=false
#   # --- TEMPORARY staging billing only (remove before real production) ---
#   BILLING_PROVIDER=manual
#   BILLING_ALLOW_MANUAL_PROVIDER=true
#   # --- Real production instead requires: ---
#   # BILLING_PROVIDER=stripe / STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY / STRIPE_WEBHOOK_SECRET
#
# Migrations are NOT run by the web container. Run them once after a schema
# change via the Railway console / CLI / one-off command:
#   python manage.py migrate --noinput        (or: sh scripts/run_migrations.sh)
#
# Vercel frontend (NEXT_PUBLIC_* only — never backend secrets):
#   NEXT_PUBLIC_SITE_URL=https://certanest.com
#   NEXT_PUBLIC_API_BASE_URL=/api/v1          # keep relative — same-origin proxy keeps auth cookies first-party
#   BACKEND_ORIGIN=https://api.certanest.com  # server-side proxy target
#   NEXT_PUBLIC_ENV=staging
#
# DO NOT enable in staging/production: DJANGO_DEBUG=True, CORS_ALLOW_ALL_ORIGINS,
# FOUNDER_ALLOW_ALL_STAFF=true. Manual billing is allowed ONLY as a temporary,
# explicitly-flagged staging shortcut and is unsafe for real production.
# ===========================================================================

# Django core
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to local sqlite if unset)
# DATABASE_URL=postgres://user:password@localhost:5432/duenest

# JWT lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Google sign-in: the OAuth 2.0 Web client id from Google Cloud Console.
# Used to verify Google ID tokens at POST /api/v1/auth/google/.
GOOGLE_OAUTH_CLIENT_ID=

# --- Production security (see docs/SECURITY_HARDENING_REPORT.md) ---
# Comma-separated; required in production. Never use "*" in production.
# DJANGO_ALLOWED_HOSTS=app.certanest.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://app.certanest.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.certanest.com
# DJANGO_CSP_CONNECT_SRC=https://api.certanest.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=3600
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_HSTS_PRELOAD=False
# DJANGO_SECURITY_HEADERS_ENABLED=True  # auto-on in production settings
# DJANGO_LOG_LEVEL=INFO

# --- Cookie-based auth (see docs/AUTH.md) ---
# Access/refresh JWTs are carried in HttpOnly cookies. Same-site deployment is
# assumed (frontend + backend share a registrable domain). For cross-site, set
# AUTH_COOKIE_SAMESITE=None + AUTH_COOKIE_SECURE=True and matching CORS/CSRF.
# Secure flags are forced on in production settings regardless of these.
# AUTH_COOKIE_SECURE=False               # True in prod (auto-forced in production.py)
# AUTH_COOKIE_SAMESITE=Lax               # None for cross-site (requires Secure)
# AUTH_COOKIE_DOMAIN=                     # e.g. .certanest.com to share across subdomains
# AUTH_COOKIE_PATH=/
# AUTH_ACCESS_COOKIE_NAME=duenest_access
# AUTH_REFRESH_COOKIE_NAME=duenest_refresh
# AUTH_CSRF_COOKIE_NAME=duenest_csrftoken
# Cookie auth requires credentialed CORS (defaults to True; origins must be an
# explicit allowlist, never "*"):
# DJANGO_CORS_ALLOW_CREDENTIALS=True

# AI (Claude / document intelligence) — OPTIONAL and KEY-GATED.
# Leave ANTHROPIC_API_KEY unset and AI features stay built but dark
# (AI_CONFIGURED=False; calls return a clear "not configured" result instead of
# crashing). Set the key to activate them — no code change required. The
# per-feature flags (apps.features: ai_features / ai_document_*) still control
# who sees each AI feature once a key is present.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-4-8           # optional override (defaults to claude-opus-4-8)
# AI_MAX_TOKENS=4096                 # optional output cap
#
# The ANTHROPIC_API_KEY is BACKEND-ONLY — never expose it to the frontend.
# COST CONTROL: on a small credit balance, set AI_MODEL to the lowest-cost
# Haiku-class model available in your Anthropic console (e.g. a claude-haiku-*
# model) rather than Opus. Every call is metered (apps.ai.AiUsage) and capped by
# the budget guard below; over a cap, AI pauses gracefully (no overspend). Usage
# rows store only token/cost accounting — never prompts, document text, or replies.
# AI_DAILY_TOKEN_CAP_USER=5000       # per-user daily token cap (success tokens)
# AI_DAILY_TOKEN_CAP_GLOBAL=25000    # global daily token cap across all users
# AI_MONTHLY_COST_LIMIT_USD=5        # global monthly estimated-spend ceiling (USD)
# AI_USAGE_METERING_ENABLED=true     # write AiUsage rows (default true)
# AI_BUDGET_GUARD_ENABLED=true       # enforce the caps before each call (default true)
#
# Content-level RAG (semantic retrieval) — OPTIONAL, SEPARATE key (Voyage AI).
# Anthropic has no embeddings model, so RAG pairs Claude with an embeddings
# provider. Leave VOYAGE_API_KEY unset and retrieval stays keyword-based
# (EMBEDDINGS_CONFIGURED=False); set it + run `manage.py build_document_embeddings`
# to make Ask / Chat / Pack Copilot semantic. No code change required.
# VOYAGE_API_KEY=
# EMBEDDINGS_MODEL=voyage-3            # optional override
#
# Chunk-level RAG (answer over document BODY content, not just metadata) — v1.
# Indexing is MANUAL only (POST /documents/{id}/ai/index/); auto-index on upload
# stays OFF so we never index the whole vault unintentionally. Embeddings are
# OPTIONAL — without a Voyage key, chunks fall back to lexical retrieval. Only
# already-extracted text (DocumentExtraction.raw_text) is used; no file binaries
# are ever sent to AI. The budget guard above still applies to every Claude call.
# AI_RAG_ENABLED=true
# AI_RAG_CHUNK_SIZE=1200              # chars per chunk
# AI_RAG_CHUNK_OVERLAP=150           # chars overlapped between chunks
# AI_RAG_MAX_CHUNKS_PER_DOCUMENT=40  # cap chunks per document (bounds cost)
# AI_RAG_MAX_CHARS_PER_DOCUMENT=60000
# AI_RAG_TOP_K=5                     # chunks retrieved per question
# AI_RAG_MAX_CONTEXT_CHARS=10000     # cap on total excerpt chars sent to Claude
# AI_RAG_AUTO_INDEX_ON_UPLOAD=false  # keep OFF (no automatic vault indexing yet)

# --- Email reminders / notifications (see docs/EMAIL_REMINDERS.md) ---
# Provider-neutral. Development needs NO credentials (console). If a provider is
# selected but not fully configured, email is recorded as "skipped" (not sent)
# instead of crashing — CertaNest never pretends an email was delivered.
#
# EMAIL_PROVIDER: console | smtp | resend | postmark | sendgrid | mailgun | ses
EMAIL_PROVIDER=console

# Generic SMTP (used for EMAIL_PROVIDER=smtp, mailgun, ses; legacy EMAIL_* also honored):
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Provider API keys (used as the SMTP password for these services):
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
AWS_SES_REGION=

# Addresses + public URLs:
DEFAULT_FROM_EMAIL=CertaNest <noreply@localhost>
SERVER_EMAIL=CertaNest <server@localhost>
SUPPORT_EMAIL=support@certanest.com
# Optional dedicated sender for branded billing notifications (trial/payment/
# cancel). Falls back to DEFAULT_FROM_EMAIL when blank. Does NOT affect Stripe's
# own receipts/invoices. Prod example: CertaNest Billing <billing@mail.certanest.com>
BILLING_FROM_EMAIL=
FRONTEND_APP_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
EMAIL_TIMEOUT=10
NOTIFICATION_REMINDER_CATCHUP_DAYS=3

# --- PWA Web Push (opt-in; see docs/PWA.md §9) ---
# Empty by default: push is fully OFF (no prompts, no delivery) until both keys
# are set. Generate a VAPID key pair with `python -m py_vapid --gen` and keep the
# private key in the environment only — never commit it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact required by the Web Push spec (defaults to SUPPORT_EMAIL).
# VAPID_SUBJECT=mailto:support@certanest.com

# Days a trashed document/file is kept before `purge_expired_trash` permanently
# deletes it (powers the Trash countdown). Set to 0 to disable auto-purge.
TRASH_RETENTION_DAYS=30

# Legacy names still supported (FRONTEND_APP_URL/SMTP_* take precedence):
# DUENEST_APP_BASE_URL=http://localhost:3000
# EMAIL_BACKEND=  EMAIL_HOST=  EMAIL_HOST_USER=  EMAIL_HOST_PASSWORD=

# File/field encryption keys (see docs/ENCRYPTION.md).
# Generate a real key with: python manage.py generate_encryption_key
# NEVER commit real keys. Losing a KEK makes data wrapped under it unrecoverable.
DUENEST_ACTIVE_KEK_VERSION=v1
DUENEST_KEK_V1_B64=replace-with-base64-encoded-32-byte-key
# Add more versions only when rotating keys:
# DUENEST_KEK_V2_B64=replace-with-base64-encoded-32-byte-key

# --- Object storage (provider-neutral; see docs/DEPLOYMENT.md) ---
# Local filesystem is used when STORAGE_BACKEND is unset or "local" (the dev
# default). Set STORAGE_BACKEND=s3 in production to use ANY S3-compatible
# provider — Cloudflare R2 (preferred for beta), Railway buckets, AWS S3, MinIO.
# Files are app-encrypted before upload and streamed back through authenticated
# endpoints; object-storage URLs are never used to deliver user files.
STORAGE_BACKEND=local
# Informational label only (local | cloudflare_r2 | railway_bucket | aws_s3 | custom_s3)
STORAGE_PROVIDER=local

# Required when STORAGE_BACKEND=s3 (production bucket name; keep it PRIVATE):
STORAGE_BUCKET_NAME=certanest-prod-documents
# R2 credentials are BACKEND-ONLY (Railway env vars). Never put them in the
# frontend / Vercel. Leave blank here; set the real values only in the secret store.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# R2 example: https://<account-id>.r2.cloudflarestorage.com  (leave blank for AWS S3)
STORAGE_ENDPOINT_URL=
# "auto" for R2; a real region (e.g. eu-west-1) for AWS S3.
STORAGE_REGION=auto
# "virtual" (default) or "path" — some providers/older setups need "path".
STORAGE_ADDRESSING_STYLE=virtual
# s3v4 works for R2 and modern S3.
STORAGE_SIGNATURE_VERSION=s3v4

# Security/behaviour (safe defaults shown):
STORAGE_PRIVATE=true
STORAGE_FILE_OVERWRITE=false
STORAGE_SIGNED_URLS=true
STORAGE_SIGNED_URL_EXPIRES_SECONDS=300
STORAGE_MEDIA_PREFIX=media/

# --- Deployment helpers ---
# Set by most platforms automatically; gunicorn binds to it.
# PORT=8000
# WEB_CONCURRENCY=3

# --- Billing (CertaNest's own monetization) ---
# Provider: "manual" (offline dev/test, activates subscriptions without payment)
# or "stripe". Test mode keeps things safe in local/dev.
BILLING_PROVIDER=manual
BILLING_TEST_MODE=true
# SECURITY (SEC-004): the manual provider accepts UNSIGNED webhooks and grants
# access with no payment. It is rejected in production (BillingConfig fails boot)
# unless this is explicitly true — which it must never be in production. When
# BILLING_PROVIDER=stripe, STRIPE_SECRET_KEY/PUBLISHABLE_KEY/WEBHOOK_SECRET are
# all required (boot fails closed otherwise).
BILLING_ALLOW_MANUAL_PROVIDER=False
# Stripe (only needed when BILLING_PROVIDER=stripe). Never expose the secret or
# webhook secret to the frontend — only STRIPE_PUBLISHABLE_KEY is client-safe.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (create products/prices in the Stripe dashboard first).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=
STRIPE_PRICE_ORG_SEAT_MONTHLY=
STRIPE_PRICE_ORG_SEAT_YEARLY=
# Where the provider returns the user after checkout / portal (frontend origin).
BILLING_SUCCESS_URL=http://localhost:3000/dashboard/settings/billing?checkout=success
BILLING_CANCEL_URL=http://localhost:3000/dashboard/settings/billing?checkout=cancelled
BILLING_PORTAL_RETURN_URL=http://localhost:3000/dashboard/settings/billing
# Days of continued access after a failed payment before downgrade.
BILLING_GRACE_PERIOD_DAYS=7

# --- Public access-code hardening (SEC-001) ---
# Repeated wrong access codes for a single share link / emergency pack / secure
# room lock THAT resource (for everyone, not just one IP). State is cache-backed,
# so configure a shared cache (Redis/DB) in multi-process production for the
# lockout (and DRF throttles) to be enforced cluster-wide.
PUBLIC_ACCESS_CODE_MAX_ATTEMPTS=8
PUBLIC_ACCESS_CODE_LOCKOUT_MINUTES=15
PUBLIC_ACCESS_CODE_BACKOFF_ENABLED=True
PUBLIC_ACCESS_CODE_MIN_LENGTH=6

# --- Public document-request upload caps (SEC-003) ---
PUBLIC_DOCUMENT_REQUEST_MAX_SUBMISSIONS=20
PUBLIC_DOCUMENT_REQUEST_MAX_TOTAL_MB=50

# --- File upload validation + malware scanning (SEC-003 / SEC-005) ---
# ClamAV via the clamd unix socket. Disabled by default for local dev. When
# enabled, CLAMD_FAIL_CLOSED rejects uploads if the scanner is unreachable
# (recommended in production). Applies to vault, scanner, organization and
# public uploads.
CLAMD_ENABLED=False
CLAMD_SOCKET_PATH=/var/run/clamav/clamd.ctl
CLAMD_FAIL_CLOSED=True

# --- Founder/admin console access (SEC-009) ---
# Founder tools are NOT granted to every staff account. Superusers always
# qualify; other staff must be on this comma-separated allowlist. The
# ALLOW_ALL_STAFF flag is a dev-only convenience and must stay False in prod.
FOUNDER_EMAILS=
FOUNDER_ALLOW_ALL_STAFF=False

# --- Verifiable Shares signing key ---
# Ed25519 private key (PEM) used to sign tamper-evident share manifests. Only the
# PUBLIC key is exposed (GET /api/v1/verify/key/). Generate one with:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization as s; print(Ed25519PrivateKey.generate().private_bytes(s.Encoding.PEM, s.PrivateFormat.PKCS8, s.NoEncryption()).decode())"
# Leave blank for local dev (an ephemeral key is generated and a warning logged).
SHARE_SIGNING_PRIVATE_KEY=

# --- Password reset / email verification (SEC-007) ---
# Single-use, time-limited token lifetimes (hours). Email delivery uses the
# EMAIL_* / EMAIL_PROVIDER settings above.
PASSWORD_RESET_TOKEN_HOURS=1
EMAIL_VERIFICATION_TOKEN_HOURS=48

# ===========================================================================
# Scale-ready lean foundation (see docs/deployment/scale-ready-lean-foundation.md)
#
# REQUIRED FOR LOCAL DEV: none of the below — the app runs in lean mode with
#   per-process cache and inline (eager) tasks out of the box.
# RECOMMENDED FOR PRIVATE STAGING: APP_ENV, DATABASE_URL (managed Postgres),
#   storage (R2/S3), EMAIL_PROVIDER + RESEND_API_KEY, SENTRY_DSN. Redis/workers
#   stay OPTIONAL until you turn on background jobs.
# REQUIRED FOR PUBLIC LAUNCH: REDIS_URL + ENABLE_BACKGROUND_JOBS + a worker
#   (and beat or platform cron), plus the staging items above on paid tiers.
# ===========================================================================

# Deployment mode marker: local | staging | production (informational + used by
# slow-request logging and health checks). The settings MODULE still sets the
# hard security posture (config.settings.development vs .production).
APP_ENV=local

# --- Redis (OPTIONAL until workers/shared cache are enabled) ---
# When set, enables Redis cache + acts as the default Celery broker/result store.
# Leave unset for lean/local mode (LocMem cache + eager tasks).
# REDIS_URL=redis://localhost:6379/0
# CACHE_URL=                         # defaults to REDIS_URL if unset
# CELERY_BROKER_URL=                 # defaults to REDIS_URL (or memory:// in lean mode)
# CELERY_RESULT_BACKEND=             # defaults to REDIS_URL (or cache+memory://)

# --- Cache behaviour ---
# ENABLE_REDIS_CACHE auto-enables when CACHE_URL/REDIS_URL is present. Force it
# off to keep LocMem even with Redis available, or on to fail closed in prod.
# ENABLE_REDIS_CACHE=True
CACHE_KEY_PREFIX=duenest
CACHE_DEFAULT_TIMEOUT=300
# Per-target TTLs (seconds). Defaults shown.
CACHE_TTL_PLAN_CATALOG=3600
CACHE_TTL_FEATURE_FLAGS=60
CACHE_TTL_ENTITLEMENTS=60
CACHE_TTL_DASHBOARD_SUMMARY=45
CACHE_TTL_UNREAD_COUNT=30
CACHE_TTL_FOUNDER_ROLLUP=600

# --- Background jobs (Celery) ---
# OFF by default: tasks run inline (eager) so no broker/worker is needed locally.
# Set to True (with REDIS_URL) to dispatch to real workers (run the `worker`
# Procfile process). ENABLE_CELERY_BEAT toggles the scheduler intent (run the
# `beat` process, or use platform cron instead).
ENABLE_BACKGROUND_JOBS=False
ENABLE_CELERY_BEAT=False
CELERY_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# --- Scale-ready subsystem toggles ---
ENABLE_FOUNDER_ANALYTICS_ROLLUPS=False
# Move scanner OCR/compression to the `scanner` queue (needs ENABLE_BACKGROUND_JOBS).
SCANNER_ASYNC_PROCESSING_ENABLED=False

# --- OCR controls (unified aliases over SCANNER_OCR_*) ---
OCR_ENABLED=True
OCR_MAX_PAGES=10
OCR_TIMEOUT_SECONDS=20

# --- Object storage (Cloudflare R2 / S3-compatible) ---
# Lean/local default is the filesystem. Set these for staging/production. Files
# are ALWAYS app-encrypted and streamed through authenticated views — storage
# URLs are never exposed for private documents.
# STORAGE_BACKEND=s3
# STORAGE_PROVIDER=cloudflare_r2
# STORAGE_BUCKET_NAME=certanest-prod-documents
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com

# --- Email provider (Resend free tier for lean staging) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# DEFAULT_FROM_EMAIL=CertaNest <noreply@yourdomain>

# --- Stripe (test mode first) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Observability ---
# Sentry is OPTIONAL: only active when SENTRY_DSN is set AND sentry-sdk is
# installed. Slow requests over SLOW_REQUEST_MS are logged (path + timing only).
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SLOW_REQUEST_MS=1000
# Warn when a single download decrypts more than this many bytes into memory.
LARGE_FILE_DOWNLOAD_WARN_BYTES=8388608
