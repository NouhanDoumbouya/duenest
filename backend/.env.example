# Copy this file to .env and fill in real values. Do NOT commit .env.

# Django core
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to local sqlite if unset)
# DATABASE_URL=postgres://user:password@localhost:5432/duenest

# JWT lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Google sign-in: the OAuth 2.0 Web client id from Google Cloud Console.
# Used to verify Google ID tokens at POST /api/v1/auth/google/.
GOOGLE_OAUTH_CLIENT_ID=

# --- Production security (see docs/SECURITY_HARDENING_REPORT.md) ---
# Comma-separated; required in production. Never use "*" in production.
# DJANGO_ALLOWED_HOSTS=app.duenest.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://app.duenest.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.duenest.com
# DJANGO_CSP_CONNECT_SRC=https://api.duenest.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=3600
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_HSTS_PRELOAD=False
# DJANGO_SECURITY_HEADERS_ENABLED=True  # auto-on in production settings
# DJANGO_LOG_LEVEL=INFO

# File/field encryption keys (see docs/ENCRYPTION.md).
# Generate a real key with: python manage.py generate_encryption_key
# NEVER commit real keys. Losing a KEK makes data wrapped under it unrecoverable.
DUENEST_ACTIVE_KEK_VERSION=v1
DUENEST_KEK_V1_B64=replace-with-base64-encoded-32-byte-key
# Add more versions only when rotating keys:
# DUENEST_KEK_V2_B64=replace-with-base64-encoded-32-byte-key
