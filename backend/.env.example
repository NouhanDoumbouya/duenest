# Copy this file to .env and fill in real values. Do NOT commit .env.

# Django core
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to local sqlite if unset)
# DATABASE_URL=postgres://user:password@localhost:5432/duenest

# JWT lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Google sign-in: the OAuth 2.0 Web client id from Google Cloud Console.
# Used to verify Google ID tokens at POST /api/v1/auth/google/.
GOOGLE_OAUTH_CLIENT_ID=

# --- Production security (see docs/SECURITY_HARDENING_REPORT.md) ---
# Comma-separated; required in production. Never use "*" in production.
# DJANGO_ALLOWED_HOSTS=app.duenest.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://app.duenest.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.duenest.com
# DJANGO_CSP_CONNECT_SRC=https://api.duenest.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=3600
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_HSTS_PRELOAD=False
# DJANGO_SECURITY_HEADERS_ENABLED=True  # auto-on in production settings
# DJANGO_LOG_LEVEL=INFO

# --- Cookie-based auth (see docs/AUTH.md) ---
# Access/refresh JWTs are carried in HttpOnly cookies. Same-site deployment is
# assumed (frontend + backend share a registrable domain). For cross-site, set
# AUTH_COOKIE_SAMESITE=None + AUTH_COOKIE_SECURE=True and matching CORS/CSRF.
# Secure flags are forced on in production settings regardless of these.
# AUTH_COOKIE_SECURE=False               # True in prod (auto-forced in production.py)
# AUTH_COOKIE_SAMESITE=Lax               # None for cross-site (requires Secure)
# AUTH_COOKIE_DOMAIN=                     # e.g. .duenest.com to share across subdomains
# AUTH_COOKIE_PATH=/
# AUTH_ACCESS_COOKIE_NAME=duenest_access
# AUTH_REFRESH_COOKIE_NAME=duenest_refresh
# AUTH_CSRF_COOKIE_NAME=duenest_csrftoken
# Cookie auth requires credentialed CORS (defaults to True; origins must be an
# explicit allowlist, never "*"):
# DJANGO_CORS_ALLOW_CREDENTIALS=True

# --- Email reminders / notifications (see docs/EMAIL_REMINDERS.md) ---
# Provider-neutral. Development needs NO credentials (console). If a provider is
# selected but not fully configured, email is recorded as "skipped" (not sent)
# instead of crashing — DueNest never pretends an email was delivered.
#
# EMAIL_PROVIDER: console | smtp | resend | postmark | sendgrid | mailgun | ses
EMAIL_PROVIDER=console

# Generic SMTP (used for EMAIL_PROVIDER=smtp, mailgun, ses; legacy EMAIL_* also honored):
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Provider API keys (used as the SMTP password for these services):
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
AWS_SES_REGION=

# Addresses + public URLs:
DEFAULT_FROM_EMAIL=DueNest <noreply@localhost>
SERVER_EMAIL=DueNest <server@localhost>
SUPPORT_EMAIL=support@duenest.com
FRONTEND_APP_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
EMAIL_TIMEOUT=10
NOTIFICATION_REMINDER_CATCHUP_DAYS=3

# Days a trashed document/file is kept before `purge_expired_trash` permanently
# deletes it (powers the Trash countdown). Set to 0 to disable auto-purge.
TRASH_RETENTION_DAYS=30

# Legacy names still supported (FRONTEND_APP_URL/SMTP_* take precedence):
# DUENEST_APP_BASE_URL=http://localhost:3000
# EMAIL_BACKEND=  EMAIL_HOST=  EMAIL_HOST_USER=  EMAIL_HOST_PASSWORD=

# File/field encryption keys (see docs/ENCRYPTION.md).
# Generate a real key with: python manage.py generate_encryption_key
# NEVER commit real keys. Losing a KEK makes data wrapped under it unrecoverable.
DUENEST_ACTIVE_KEK_VERSION=v1
DUENEST_KEK_V1_B64=replace-with-base64-encoded-32-byte-key
# Add more versions only when rotating keys:
# DUENEST_KEK_V2_B64=replace-with-base64-encoded-32-byte-key

# --- Object storage (provider-neutral; see docs/DEPLOYMENT.md) ---
# Local filesystem is used when STORAGE_BACKEND is unset or "local" (the dev
# default). Set STORAGE_BACKEND=s3 in production to use ANY S3-compatible
# provider — Cloudflare R2 (preferred for beta), Railway buckets, AWS S3, MinIO.
# Files are app-encrypted before upload and streamed back through authenticated
# endpoints; object-storage URLs are never used to deliver user files.
STORAGE_BACKEND=local
# Informational label only (local | cloudflare_r2 | railway_bucket | aws_s3 | custom_s3)
STORAGE_PROVIDER=local

# Required when STORAGE_BACKEND=s3:
STORAGE_BUCKET_NAME=duenest-prod
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# R2 example: https://<account-id>.r2.cloudflarestorage.com  (leave blank for AWS S3)
STORAGE_ENDPOINT_URL=
# "auto" for R2; a real region (e.g. eu-west-1) for AWS S3.
STORAGE_REGION=auto
# "virtual" (default) or "path" — some providers/older setups need "path".
STORAGE_ADDRESSING_STYLE=virtual
# s3v4 works for R2 and modern S3.
STORAGE_SIGNATURE_VERSION=s3v4

# Security/behaviour (safe defaults shown):
STORAGE_PRIVATE=true
STORAGE_FILE_OVERWRITE=false
STORAGE_SIGNED_URLS=true
STORAGE_SIGNED_URL_EXPIRES_SECONDS=300
STORAGE_MEDIA_PREFIX=media/

# --- Deployment helpers ---
# Set by most platforms automatically; gunicorn binds to it.
# PORT=8000
# WEB_CONCURRENCY=3

# --- Billing (DueNest's own monetization) ---
# Provider: "manual" (offline dev/test, activates subscriptions without payment)
# or "stripe". Test mode keeps things safe in local/dev.
BILLING_PROVIDER=manual
BILLING_TEST_MODE=true
# SECURITY (SEC-004): the manual provider accepts UNSIGNED webhooks and grants
# access with no payment. It is rejected in production (BillingConfig fails boot)
# unless this is explicitly true — which it must never be in production. When
# BILLING_PROVIDER=stripe, STRIPE_SECRET_KEY/PUBLISHABLE_KEY/WEBHOOK_SECRET are
# all required (boot fails closed otherwise).
BILLING_ALLOW_MANUAL_PROVIDER=False
# Stripe (only needed when BILLING_PROVIDER=stripe). Never expose the secret or
# webhook secret to the frontend — only STRIPE_PUBLISHABLE_KEY is client-safe.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (create products/prices in the Stripe dashboard first).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=
STRIPE_PRICE_ORG_SEAT_MONTHLY=
STRIPE_PRICE_ORG_SEAT_YEARLY=
# Where the provider returns the user after checkout / portal (frontend origin).
BILLING_SUCCESS_URL=http://localhost:3000/dashboard/settings/billing?checkout=success
BILLING_CANCEL_URL=http://localhost:3000/dashboard/settings/billing?checkout=cancelled
BILLING_PORTAL_RETURN_URL=http://localhost:3000/dashboard/settings/billing
# Days of continued access after a failed payment before downgrade.
BILLING_GRACE_PERIOD_DAYS=7

# --- Public access-code hardening (SEC-001) ---
# Repeated wrong access codes for a single share link / emergency pack / secure
# room lock THAT resource (for everyone, not just one IP). State is cache-backed,
# so configure a shared cache (Redis/DB) in multi-process production for the
# lockout (and DRF throttles) to be enforced cluster-wide.
PUBLIC_ACCESS_CODE_MAX_ATTEMPTS=8
PUBLIC_ACCESS_CODE_LOCKOUT_MINUTES=15
PUBLIC_ACCESS_CODE_BACKOFF_ENABLED=True
PUBLIC_ACCESS_CODE_MIN_LENGTH=6

# --- Public document-request upload caps (SEC-003) ---
PUBLIC_DOCUMENT_REQUEST_MAX_SUBMISSIONS=20
PUBLIC_DOCUMENT_REQUEST_MAX_TOTAL_MB=50

# --- File upload validation + malware scanning (SEC-003 / SEC-005) ---
# ClamAV via the clamd unix socket. Disabled by default for local dev. When
# enabled, CLAMD_FAIL_CLOSED rejects uploads if the scanner is unreachable
# (recommended in production). Applies to vault, scanner, organization and
# public uploads.
CLAMD_ENABLED=False
CLAMD_SOCKET_PATH=/var/run/clamav/clamd.ctl
CLAMD_FAIL_CLOSED=True

# --- Founder/admin console access (SEC-009) ---
# Founder tools are NOT granted to every staff account. Superusers always
# qualify; other staff must be on this comma-separated allowlist. The
# ALLOW_ALL_STAFF flag is a dev-only convenience and must stay False in prod.
FOUNDER_EMAILS=
FOUNDER_ALLOW_ALL_STAFF=False

# --- Password reset / email verification (SEC-007) ---
# Single-use, time-limited token lifetimes (hours). Email delivery uses the
# EMAIL_* / EMAIL_PROVIDER settings above.
PASSWORD_RESET_TOKEN_HOURS=1
EMAIL_VERIFICATION_TOKEN_HOURS=48
